{
  "name": "accessibility-red-team",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first accessibility observatory for Swiss public-sector websites",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "scan": "tsx src/cli.ts scan",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check": "npm run build && npm test",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "axe-core": "4.13.0",
    "playwright": "1.63.0",
    "yaml": "^2.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
