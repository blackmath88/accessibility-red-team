{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "art/system-fingerprint/v1",
  "title": "SystemFingerprint",
  "type": "object",
  "required": ["schema","propertyId","observedAt","signals"],
  "properties": {
    "schema": {"const":"art/system-fingerprint/v1"},
    "propertyId":{"type":"string","minLength":1},
    "observedAt":{"type":"string","format":"date-time"},
    "signals":{"type":"array","items":{
      "type":"object",
      "required":["dimension","value","provenance","confidence","evidence","method"],
      "properties":{
        "dimension":{"enum":["cms","hosting_cdn","frontend_framework","design_system","site_vendor","form_service","search_service","consent_tool","document_viewer","map_gis","identity_provider","third_party_service","asset_origin","other"]},
        "value":{"type":"string","minLength":1},
        "provenance":{"enum":["OBSERVED","INFERRED","ENRICHED"]},
        "confidence":{"type":"number","minimum":0,"maximum":1},
        "evidence":{"type":"array","minItems":1,"items":{"type":"string"}},
        "method":{"type":"string","minLength":1}
      },
      "additionalProperties":false
    }}
  },
  "additionalProperties":false
}
