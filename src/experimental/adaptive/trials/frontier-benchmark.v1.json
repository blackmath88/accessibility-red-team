  "provider": "mistral",
  "apiKeyEnv": "ADAPTIVE_MISTRAL_API_KEY",
  "baseUrl": "https://api.mistral.ai",
  "models": {
    "baseline": {
      "model": "mistral-small-2603",
      "pricing": {
        "currency": "USD",
        "inputPerMillion": 0.15,
        "outputPerMillion": 0.6,
        "source": "https://docs.mistral.ai/models/mistral-small-4-0-26-03",
        "checkedOn": "2026-10-25"
      }
    },
    "stronger": {
      "model": "OWNER_SUPPLIED_PINNED_MODEL_ID",
      "pricing": {
        "currency": "USD",
        "inputPerMillion": null,
        "outputPerMillion": null,
        "source": "OWNER_SUPPLIED",
        "checkedOn": "OWNER_SUPPLIED"
      }
    }
  },
  "conditions": [
    {
      "id": "A",
      "label": "historical tester (condition A, skill v3)",
      "model": "baseline",
      "condition": {
        "schema": "art/adaptive-condition/v1",
        "ledgerVisible": false,
        "completionAccounting": false,
        "incrementalCandidates": false,
        "selector": "model"
      }
    },
    {
      "id": "hidden",
