      "model": "baseline",
      "condition": {
        "schema": "art/adaptive-condition/v1",
        "ledgerVisible": false,
        "completionAccounting": true,
        "incrementalCandidates": true,
        "selector": "model"
      }
    },
    {
      "id": "B",
      "label": "same model, ledger visible + completion accounting",
      "model": "baseline",
      "condition": {
        "schema": "art/adaptive-condition/v1",
        "ledgerVisible": true,
        "completionAccounting": true,
        "incrementalCandidates": true,
        "selector": "model"
      }
    },
    {
      "id": "C",
      "label": "stronger pinned model, same ledger and tools as B",
      "model": "stronger",
      "condition": {
        "schema": "art/adaptive-condition/v1",
        "ledgerVisible": true,
        "completionAccounting": true,
        "incrementalCandidates": true,
        "selector": "model"
      }
    },
    {
      "id": "D",
      "label": "deterministic scheduler + rule table, no model",
      "model": null,
      "condition": {
        "schema": "art/adaptive-condition/v1",
        "ledgerVisible": true,
        "completionAccounting": true,
        "incrementalCandidates": true,
        "selector": "scheduler"
